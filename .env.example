# Optional. The deterministic investigator and native solver require no model key.
# Copy to .env, edit locally, then explicitly load it before starting Python:
# set -a
# source .env
# set +a
# HOLDOUT never sends these settings or the key to the browser.
# Optional Requesty live-agent route tested with earlier HOLDOUT releases.
# Leave OPENAI_API_KEY blank to run without an LLM.
# For direct OpenAI instead: MODEL=gpt-6.1-sol and API_BASE=https://api.openai.com/v1.
OPENAI_API_KEY=
HOLDOUT_MODEL=openai/gpt-6.1-sol
HOLDOUT_API_BASE=https://router.requesty.ai/v1
# GPT-6 tool calling requires Responses. Use chat_completions for another
# compatible endpoint that implements Chat Completions function tools.
HOLDOUT_API_MODE=responses
HOLDOUT_REASONING_EFFORT=low
# Per-response output budget includes reasoning tokens in Responses mode.
HOLDOUT_MAX_OUTPUT_TOKENS=4096
# Optional external FalkorDB server; omit to use the local embedded engine.
HOLDOUT_FALKORDB_URL=
# Local module override is normally set by scripts/probe_engine.py setup.
HOLDOUT_FALKORDB_MODULE=
# Provider limits for one live model run. The local execution timeout also applies.
HOLDOUT_MAX_PROVIDER_CALLS=24
HOLDOUT_MAX_TOOL_CALLS=36
HOLDOUT_MAX_TOKENS=100000
HOLDOUT_MAX_SECONDS=180

# Independent Stage 2 browser port; internal application still uses port 8000.
HOLDOUT_HOST_PORT=8100

# Planner limits are separate from model budgets. Native calls are bounded between operations.
HOLDOUT_PLAN_MAX_CANDIDATES=32
HOLDOUT_PLAN_MAX_SECONDS=30
# Graph-guided deterministic mode: maximum evidence batches per run (no API key).
HOLDOUT_GUIDED_MAX_INVESTIGATIONS=24

# Stage 5 policy context is synthetic and bundled in fixtures/organization.
# Reviewer selection in the local app is a demo attestation, NOT authenticated approval.

# Stage 6: local files are polled without sending data to a model.
HOLDOUT_WATCH_INTERVAL=15
